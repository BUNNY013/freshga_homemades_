rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper Functions
    // =========================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================
    // Default Deny
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      allow read, write: if true; // Admin needs to approve users and change roles
      
      match /followingStores/{storeId} {
        allow read, write: if isOwner(userId);
      }

      match /liked_products/{productId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================
    // CUSTOMERS
    // =========================

    match /customers/{userId} {
      allow read, write: if isOwner(userId);

      match /liked_products/{productId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================
    // SUPPLIER APPLICATIONS
    // =========================

    match /supplierApplications/{applicationId} {
      allow read: if true; // Admin app needs to read all applications
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if true; // Admin app needs to update status
      allow delete: if false;
    }

    // =========================
    // SEEDER ALLOWED COLLECTIONS
    // =========================
    // WARNING: These collections are temporarily set to `allow write: if true;` 
    // to allow the development seeder to work from the client app. 
    // Revert these to secure rules before deploying to production!

    match /store_subscriptions/{document} {
      allow read, write: if true;
    }

    match /supplier_applications/{document} {
      allow read, write: if true;
    }

    match /stores/{storeId} {
      allow read, write: if true; 
      
      match /followers/{userId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{document=**} {
      allow read, write: if true;
    }

    match /categories/{document} {
      allow read, write: if true;
    }

    match /subcategories/{document} {
      allow read, write: if true;
    }

    match /sub_categories/{document} {
      allow read, write: if true;
    }

    match /tags/{document} {
      allow read, write: if true;
    }

    match /banners/{document} {
      allow read, write: if true;
    }

    match /collections/{document} {
      allow read, write: if true;
    }

    match /home_sections/{document} {
      allow read, write: if true;
    }

    match /trust_features/{document} {
      allow read, write: if true;
    }

    match /store_updates/{document} {
      allow read, write: if true;
    }

    match /appConfig/{document} {
      allow read, write: if true;
    }

    // =========================
    // ADMIN SETTINGS
    // =========================
    match /admin_settings/{document} {
      allow read, write: if true;
    }
    
    match /global_settings/{document} {
      allow read, write: if true;
    }

    match /orders/{document=**} {
      allow read, write: if true; // Temporarily relaxed for testing
    }

    match /reviews/{document=**} {
      allow read, write: if true;
    }

    // =========================
    // COUNTERS
    // =========================

    match /counters/{counterId} {
      allow read, write: if true; // Required for transactional Order IDs
    }

    // =========================
    // FOLLOWERS
    // =========================

    match /followers/{followId} {
      allow read, write: if isAuthenticated();
    }

    // =========================
    // TRANSACTIONS & PAYOUTS
    // =========================

    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    match /payouts/{payoutId} {
      allow read, write: if isAuthenticated();
    }

    // =========================
    // REFUND REQUESTS
    // =========================

    match /refund_requests/{requestId} {
      allow read, write: if true; // Temporarily relaxed for Admin app access
    }

    // =========================
    // REPORTS & MODERATION
    // =========================

    match /reports/{reportId} {
      allow read, write: if true; // Allows customers to submit store/product reports & Admin to moderate
    }

    // =========================
    // SUPPORT TICKETS
    // =========================
    match /support_tickets/{document=**} {
      allow read, write: if true; // Temporarily relaxed so users can submit queries and replies
    }

    // =========================
    // VENDOR SUPPORT TICKETS
    // =========================
    match /vendor_support_tickets/{document=**} {
      allow read, write: if true; // Relaxed for vendor support tickets to work easily
    }

    // =========================
    // BANK UPDATE REQUESTS
    // =========================
    match /bankUpdateRequests/{requestId} {
      allow read: if true; // Admin app needs to read all requests
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if true; // Admin app needs to approve/reject
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
